#!/usr/bin/env bash
# townctl — create and equip the town's minds.
#
#   ./scripts/townctl equip ada        give an identity a body's worth of tooling
#   ./scripts/townctl new ada          create the identity, then equip it
#   ./scripts/townctl list
#
# `equip` is idempotent; re-run it after `identity sync-thinkers`, which can
# restore a stock thinker lib over the patch below.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT=$(pwd)
# shellcheck disable=SC1091
source scripts/agent-env.sh

MODEL="${TOWN_THINK_MODEL:-deepseek/deepseek-v4-flash-0731}"

die() { printf 'townctl: %s\n' "$*" >&2; exit 1; }

equip() {
    local name="${1:?usage: townctl equip <name>}"
    local dir="$TOWN_IDENTITIES/$name"
    [[ -d "$dir" ]] || die "no identity '$name' (try: townctl new $name)"

    # 1. The town skill, as a KERNEL skill. Kernel skills are injected into the
    #    system prompt in full, and crucially reach the responder too -- which is
    #    where the group turn-taking policy has to land. A regular skill would
    #    only contribute its name and description. (PLAN.md §4)
    #    COPIED, never symlinked. shellm mounts dirname() of every symlink
    #    target it finds in the identity dir, and dirname("$ROOT/town") is the
    #    REPO ROOT -- so this one link mounted the whole repo into the sandbox
    #    and every mind could read every other mind's trajectory and memories.
    #    A copy has no outside target, so a sandbox sees only its own identity.
    rm -rf "$dir/kernel/town"
    mkdir -p "$dir/kernel/town"
    cp "$ROOT/town/SKILL.md" "$dir/kernel/town/SKILL.md"

    # 2. The `town` binary has to reach generated code, which runs in a Docker
    #    sandbox, so being on the host PATH is not enough: shellm only exposes
    #    binaries passed with --bin. Those come from a fixed list in the thinker
    #    lib, and a skill's `requires.bins` does NOT inject them -- it is only an
    #    eligibility check that hides the skill when the binary is missing.
    #
    #    The identity owns a COPY of the thinker lib (identity sync-thinkers
    #    preserves local edits), so extending that list is per-identity
    #    configuration rather than a headlong core edit. Upstream candidate:
    #    have _build_shellm_flags honour requires.bins.
    local lib="$dir/thinkers/_lib/common.sh"
    [[ -f "$lib" ]] || die "no thinker lib at $lib"
    #    Emit an ABSOLUTE path rather than adding `town` to the name list the
    #    loop resolves with `command -v`. That loop depends on the PATH of
    #    whichever process launched the thinker -- the dispatcher and the bridge
    #    each build their own -- so a mind's body silently disappeared from its
    #    sandbox depending on who woke it. An absolute path cannot vary.
    if ! ./scripts/_expose-town-bin.py "$lib" "$ROOT/town/town" >/dev/null; then
        die "could not expose the town binary in $lib"
    fi
    printf '  town binary exposed to %s (absolute path)\n' "$name"

    # 3. Cap a wakeup. A monolith wakeup is one function: pick it, do it, append
    #    a step, stop. shellm's loop ends only when the model writes FINAL=...,
    #    and SHELLM_MAX_ITERATIONS defaults to unlimited -- so a model that never
    #    emits the signal turns one wakeup into an unbounded exploration session
    #    (seen: 13+ full-context calls, still climbing). The cap is the backstop.
    local envf="$dir/.env"
    if ! grep -q '^SHELLM_MAX_ITERATIONS=' "$envf" 2>/dev/null; then
        printf 'SHELLM_MAX_ITERATIONS=%s\n' "${TOWN_MAX_ITERATIONS:-20}" >> "$envf"
        chmod 600 "$envf"
        printf '  capped wakeups at %s iterations\n' "${TOWN_MAX_ITERATIONS:-20}"
    fi

    # 4. Pin the model. Sourcing `activate` bare otherwise falls back to
    #    claude-opus-4-7, an Anthropic default we have no key for.
    if ! grep -q '^think_model=' "$dir/info.txt"; then
        printf 'think_model=%s\n' "$MODEL" >> "$dir/info.txt"
        printf '  pinned think_model=%s\n' "$MODEL"
    fi
    printf 'equipped %s\n' "$name"
}

case "${1:-}" in
    equip) shift; equip "$@" ;;
    new)
        shift
        name="${1:?usage: townctl new <name>}"
        town-identity new "$name"
        equip "$name"
        ;;
    list) town-identity list ;;
    *) printf 'usage: townctl {new|equip|list} [name]\n' >&2; exit 1 ;;
esac
