# Copy to .env and edit.  `docker compose` reads this file automatically.

# --- Convex (self-hosted) ---------------------------------------------------
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791
FRONTEND_PORT=5173
INSTANCE_NAME=headlong-town
# Generate once:  openssl rand -hex 32
INSTANCE_SECRET=

# Actions must outlive an LLM call. Stock AI Town needs ~30s on a local model;
# a Headlong mind is slower. See PLAN.md §13 on ACTION_TIMEOUT.
ACTIONS_USER_TIMEOUT_SECS=120

# --- LLM (OpenRouter for everything) ----------------------------------------
# OpenRouter serves both chat and embeddings from one key, on an OpenAI-shaped
# API: <LLM_API_URL>/v1/chat/completions and <LLM_API_URL>/v1/embeddings, which
# is exactly what ai-town's `custom` provider branch expects.
#
# These are *Convex* env vars, not compose ones. The backend container does not
# read them from here; Convex functions read them from Convex's own env store.
# `scripts/setup-baseline.sh` reads these values and applies them with
# `convex env set`.
AITOWN_LLM_API_URL=https://openrouter.ai/api
AITOWN_LLM_API_KEY=
# Must be a NON-reasoning model. ai-town hardcodes max_tokens: 300, and a
# thinking model spends that budget on its `reasoning` field and returns an
# empty message, with no error. See PLAN.md §13.
AITOWN_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# EMBEDDING_DIMENSION in ai-town/convex/util/llm.ts must match this model.
# text-embedding-3-large = 3072.
AITOWN_LLM_EMBEDDING_MODEL=openai/text-embedding-3-large
