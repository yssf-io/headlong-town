# Copy to .env and edit.  `docker compose` reads this file automatically.

# --- Convex (self-hosted) ---------------------------------------------------
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791
FRONTEND_PORT=5173
INSTANCE_NAME=headlong-town
# Generate once:  openssl rand -hex 32
INSTANCE_SECRET=

# Actions must outlive an LLM call. Stock AI Town needs ~30s on a local model;
# a Headlong mind is slower. See PLAN.md §13 on ACTION_TIMEOUT.
ACTIONS_USER_TIMEOUT_SECS=120

# --- LLM for the M0 baseline only -------------------------------------------
# Stock AI Town needs BOTH chat and embeddings. OpenRouter has no embeddings
# endpoint, so the baseline uses Ollama for both. This whole layer is deleted in
# M3, when Headlong's `mem` takes over memory — see PLAN.md §5.
#
# NOTE: these are *Convex* env vars, not compose ones. The backend container
# does not read them from here; Convex functions read them from Convex's own env
# store. `scripts/setup-baseline.sh` reads these values and applies them with
# `convex env set`. From inside the container, the host is host.docker.internal.
#
# OLLAMA_MODEL matters: the default is `llama3`, and convex/util/llm.ts
# auto-pulls a missing model (tryPullOllama), so a wrong value silently starts a
# multi-GB download. Set it to a model you actually have (`ollama list`).
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
